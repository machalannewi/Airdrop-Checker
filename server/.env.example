PORT=5000

# MongoDB connection string
MONGO_URI=

# Secret used to sign JWTs — use a long random value, e.g. `openssl rand -hex 64`
JWT_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Outbound email (Gmail app password, not your account password)
EMAIL_USER=
EMAIL_PASS=

# Deposit wallet addresses shown to subscribers
BTC_ADDRESS=
ETH_ADDRESS=
SOL_ADDRESS=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://airdrop-checker-two.vercel.app

# Public URL of the frontend, used for Paystack redirect callbacks
FRONTEND_URL=http://localhost:5173

# Public URL of this server, used as the Paystack callback_url
BACKEND_URL=http://localhost:5000
